{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipx App",
  "version": "0.1.9",
  "identifier": "com.godiegh.clipx",
  "build": {
    "beforeDevCommand": "cargo build -p clipx-core --manifest-path ../Cargo.toml && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipx",
        "visible": false,
        "width": 400,
        "height": 700,
        "decorations": false,
        "resizable": true,
        "transparent": true
      },
      {
        "label": "splash",
        "title": "ClipX",
        "url": "index.html?splash=1",
        "visible": false,
        "width": 240,
        "height": 240,
        "center": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
